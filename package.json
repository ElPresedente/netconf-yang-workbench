{
  "name": "netconf-client",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop NETCONF/YANG client",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc -p electron/tsconfig.json && vite build",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:backend": "backend/.venv/bin/python -m pytest -q backend/tests",
    "test:desktop": "node scripts/smoke.mjs",
    "test:dev": "node scripts/dev-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.4.3",
    "playwright": "^1.55.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
